---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import '../styles/admin.css';
const authUrl = import.meta.env.NEON_AUTH_BASE_URL || '';
---
<Layout title="Administración | Invitación">
  <div class="admin" id="admin-app" data-auth-url={authUrl}>
    <header class="admin-header"><div><p class="eyebrow">PANEL DE LA FIESTA</p><h1>Invitados <span>✦</span></h1><p>Organiza la lista y comparte cada invitación.</p></div><button id="logout" hidden>Cerrar sesión</button></header>
    <p id="message" class="notice" role="status" aria-live="polite">Inicia sesión para administrar la lista.</p>
    <section id="login-section" class="panel"><h2>Acceso de administración</h2><form method="post" onsubmit="return false" id="login-form" class="form"><label>Correo <input name="email" type="email" autocomplete="username" required /></label><label>Contraseña <input name="password" type="password" autocomplete="current-password" required /></label><button>Entrar</button></form><p class="helper">La cuenta administradora debe estar autorizada en la configuración del servidor.</p></section>
    <section id="dashboard" hidden>
      <section class="stats" aria-label="Resumen"><div><span>INVITADOS</span><strong id="total">0</strong></div><div><span>CONFIRMARON</span><strong id="attending">0</strong></div><div><span>NO ASISTIRÁN</span><strong id="declined">0</strong></div><div><span>PENDIENTES</span><strong id="pending-count">0</strong></div></section>
      <section class="panel"><h2>Agregar invitado</h2><form method="post" onsubmit="return false" id="guest-form" class="form"><input type="hidden" name="id" /><label>Nombre <input name="name" maxlength="160" required /></label><label class="check"><input type="checkbox" name="companion" /> Permitir un acompañante</label><label>Nombre del acompañante (opcional) <input name="companionName" maxlength="160" /></label><div><button type="submit">Guardar</button> <button type="button" id="cancel-edit" hidden>Cancelar edición</button></div></form></section>
      <section class="panel"><div class="panel-heading"><div><h2>Lista de invitados</h2><p>Comparte cada enlace por WhatsApp.</p></div><div class="panel-actions"><button type="button" id="refresh-list">Actualizar respuestas</button><button type="button" id="export-csv">Descargar CSV</button></div></div><div class="toolbar"><label for="search">Buscar</label><input id="search" type="search" placeholder="Nombre del invitado" /><label for="status">Estado</label><select id="status"><option value="all">Todos</option><option value="pending">Pendientes</option><option value="attending">Confirmaron</option><option value="declined">No asistirán</option></select></div><div id="guest-list" class="guest-list"></div></section>
    </section>
  </div>
  <script src="../features/admin/panel.ts"></script>
</Layout>
