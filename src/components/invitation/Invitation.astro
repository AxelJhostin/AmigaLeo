---
interface Props { name?: string }
const { name } = Astro.props;
---
<div class="scene">
  <article class="card" aria-label="Invitación de cumpleaños">
    <div class="disco disco-left" aria-hidden="true"></div><div class="disco disco-right" aria-hidden="true"></div>
    <span class="twinkle t1" aria-hidden="true">✦</span><span class="twinkle t2" aria-hidden="true">✧</span><span class="twinkle t3" aria-hidden="true">✦</span><span class="twinkle t4" aria-hidden="true">✧</span>
    <div class="card-content">
      <p class="topline">UNA NOCHE PARA CELEBRAR<br />Y RECORDAR PARA SIEMPRE</p>
      <p class="greeting">{name ? `${name}, estás invitad@` : 'Esta invitación es para ti'}</p>
      <div class="headline"><p class="script">Te invito a festejar</p><p class="small-title">✦ &nbsp; MI CUMPLE &nbsp; ✦</p><h1>LET'S<br /><span>PARTY</span></h1><div class="underline" aria-hidden="true"></div></div>
      <p class="subtitle">UNA NOCHE BRILLANTE NOS ESPERA</p>
      <div class="details">
        <div class="detail"><span class="icon" aria-hidden="true">◷</span><p class="label">FECHA Y HORA</p><p class="value">PRÓXIMAMENTE</p></div>
        <div class="detail"><span class="icon" aria-hidden="true">⌖</span><p class="label">UBICACIÓN</p><p class="value">ES UN SECRETO</p><p class="note">Se revelará con un código de un solo uso</p></div>
      </div>
      <div class="dress"><span class="dress-star" aria-hidden="true">✧</span><p class="label">DRESS CODE</p><p class="dress-title">FULL BLACK</p><p class="bikini">BIKINI OBLIGATORIO</p></div>
      <section class="confirmation" aria-labelledby="rsvp-title"><p class="script" id="rsvp-title">¿Vienes a celebrar?</p><p>Confirma tu asistencia hasta el<br /><strong>16 DE NOVIEMBRE DE 2026</strong></p><div class="pending">CONFIRMACIÓN DISPONIBLE PRONTO</div></section>
      <footer>GOOD MUSIC <span>✦</span> GOOD FRIENDS <span>✦</span> GOOD VIBES</footer>
    </div>
  </article>
</div>
